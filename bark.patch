diff --git a/static/bark.css b/static/bark.css
new file mode 100644
index 0000000..e028380
--- /dev/null
+++ b/static/bark.css
@@ -0,0 +1,87 @@
+html,body {overscroll-behavior:none;}
+body.bark-editor {overflow:hidden; user-select:none; -webkit-user-select:none;}
+input,textarea,[contenteditable=true] {user-select:text; -webkit-user-select:text;}
+#bark-tools {height:38px;box-sizing:border-box;display:flex;align-items:center;gap:4px;padding:3px 8px;background:#202329;color:#eee;border-bottom:1px solid #101216;font:12px Arial,sans-serif;white-space:nowrap;position:relative;z-index:8;}
+#bark-tools button,#bark-tools select,.bark-dialog button {border:1px solid #48505b;border-radius:4px;color:#f4f5f7;background:#303640;min-height:30px;padding:4px 9px;font:inherit;cursor:pointer;}
+#bark-tools button:hover,.bark-dialog button:hover {background:#435366;border-color:#39bce9;}
+#bark-tools button:focus-visible,.bark-dialog button:focus-visible {outline:2px solid #55d3ff;outline-offset:1px;}
+#bark-tools button:disabled {opacity:.5;cursor:wait;}
+#bark-tools .bark-run {color:#80e6a3;}
+#bark-tools .bark-stop {color:#ff9b9b;}
+.bark-divider {height:20px;border-left:1px solid #4b515b;margin:0 4px;}
+.bark-search {display:flex;min-width:100px;max-width:205px;margin-left:5px;}
+.bark-search input {width:100%;min-width:40px;border:1px solid #48505b;border-radius:4px 0 0 4px;background:#15191e;color:white;padding:5px 8px;font:inherit;}
+.bark-status {margin-left:auto;font-size:11px;color:#b2bcc8;overflow:hidden;text-overflow:ellipsis;}
+#bark-tools .bark-recover {background:#147ca5;color:white;}
+.bark-modal-overlay {position:fixed;inset:0;background:#0009;z-index:100000;display:flex;justify-content:center;align-items:center;padding:10px;}
+.bark-dialog {background:#252a31;color:#edf0f5;font:14px/1.5 Arial,sans-serif;max-width:640px;width:100%;max-height:calc(100dvh - 20px);border-radius:6px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 12px 50px #0006;}
+.bark-dialog header {display:flex;align-items:center;justify-content:space-between;background:#138dbb;padding:10px 16px;flex:none;}
+.bark-dialog h2 {font-size:18px;margin:0;}
+.bark-dialog-body {overflow:auto;padding:16px 22px;}
+.bark-dialog p {margin:0 0 14px;}
+.bark-dialog a {color:#70d8ff;}
+.bark-dialog label {display:block;margin-bottom:14px;}
+.bark-saved-project {display:flex;align-items:center;gap:8px;padding:12px 0;border-top:1px solid #454c57;}
+.bark-saved-project>div {flex:1;min-width:0;overflow-wrap:anywhere;}
+.bark-saved-project small {display:block;color:#a7b3c4;}
+#bark-rotate {display:none;}
+.bark-hide-stage [class*="gui_stage-and-target-wrapper"] {display:none!important;}
+.bark-hide-sprites [class*="gui_target-wrapper"] {display:none!important;}
+.bark-reduced-motion *, .bark-reduced-motion *:before,.bark-reduced-motion *:after {animation:none!important;transition:none!important;scroll-behavior:auto!important;}
+[class*="menu-bar_scratch-logo"] {width:100px!important;}
+[class*="modal_modal-content"], [class*="custom-procedures_modal-content"] {max-width:calc(100vw - 24px);max-height:calc(100dvh - 24px);}
+[class*="custom-procedures_modal-content"] {margin:12px auto!important;overflow-y:auto!important;}
+[class*="custom-procedures_workspace"] {min-height:120px!important;}
+[class*="custom-procedures_body"] {padding:14px 22px!important;}
+[class*="custom-procedures_option-card"] {padding:10px!important;}
+[class*="custom-procedures_color-picker-area"] {margin:10px 0!important;}
+[class*="custom-procedures_preset-color"], [class*="custom-procedures_parent-custom"] {width:26px!important;height:26px!important;}
+@media (max-width:1100px) {
+ .bark-status {display:none;}
+ [class*="menu-bar_feedbackLink"], [class*="menu-bar_language-menu"] {display:none!important;}
+ [class*="menu-bar_menu-bar-item"] {padding-left:5px!important;padding-right:5px!important;}
+ [class*="gui_editor-wrapper"] {flex-basis:0!important;min-width:0!important;}
+ [class*="gui_stage-and-target-wrapper"] {max-width:260px;overflow:auto;}
+ [class*="gui_tab"] {padding-left:10px!important;padding-right:10px!important;}
+}
+@media (max-width:1000px) and (orientation:landscape) {
+ #bark-tools {padding-left:max(5px,env(safe-area-inset-left));padding-right:max(5px,env(safe-area-inset-right));gap:3px;}
+ #bark-tools button {padding:4px 7px;}
+ #bark-tools .bark-search {max-width:130px;}
+ [class*="menu-bar_menu-bar"] {height:40px!important;}
+ [class*="gui_body-wrapper"] {height:calc(100% - 78px)!important;}
+ [class*="menu-bar_scratch-logo"] {width:76px!important;}
+ [class*="menu-bar_divider"], [class*="menu-bar_account-info-group"] {display:none!important;}
+ [class*="gui_target-wrapper"] {min-height:170px!important;}
+ [class*="custom-procedures_modal-content"] {margin:6px auto!important;max-height:calc(100dvh - 12px);}
+ [class*="custom-procedures_workspace"] {min-height:80px!important;}
+ [class*="custom-procedures_body"] {padding:8px 14px!important;}
+ [class*="custom-procedures_option-icon"] {max-height:27px!important;margin-bottom:3px!important;}
+ [class*="custom-procedures_option-card"] {font-size:11px;padding:6px!important;}
+ [class*="custom-procedures_color-picker-area"] {margin:6px 0!important;padding:4px!important;}
+ [class*="custom-procedures_preset-color"], [class*="custom-procedures_parent-custom"] {width:22px!important;height:22px!important;margin:3px!important;}
+ [class*="custom-procedures_button-row"] {margin-top:7px!important;}
+ [class*="custom-procedures_button-row"] button {padding:8px 16px!important;}
+}
+@media (max-width:760px) and (orientation:landscape) {
+ #bark-tools .bark-search {display:none;}
+ #bark-tools .bark-run span,#bark-tools .bark-stop span {display:none;}
+ #bark-tools {font-size:11px;}
+}
+@media (max-width:700px) and (orientation:portrait) and (pointer:coarse) {
+ #bark-rotate {position:fixed;inset:0;z-index:999999;background:#1d2128;color:#f1f6fb;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px;font:15px/1.6 Arial,sans-serif;}
+ #bark-rotate h1 {font-size:22px;letter-spacing:1px;margin:20px 0 10px;}
+ .bark-phone {font-size:110px;color:#51c5ed;animation:bark-rotate-phone 3s ease-in-out infinite;line-height:1;}
+}
+@keyframes bark-rotate-phone {0%,20%{transform:rotate(0deg)}50%,85%{transform:rotate(90deg)}100%{transform:rotate(0deg)}}
+@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;}}
+#bark-tools {overflow-x:auto;scrollbar-width:thin;}
+#bark-tools>* {flex-shrink:0;}
+#bark-tools .bark-search {flex-shrink:1;}
+@media (max-height:600px) {
+ [class*="custom-procedures_modal-content"] {overflow:hidden!important;}
+ [class*="custom-procedures_modal-content"]>div {max-height:calc(100dvh - 24px);display:flex;flex-direction:column;}
+ [class*="custom-procedures_workspace"] {flex:0 0 80px;min-height:80px!important;}
+ [class*="custom-procedures_body"] {overflow-y:auto;min-height:0;}
+ [class*="custom-procedures_modal-content"] [class*="modal_header"] {flex-shrink:0;}
+}
