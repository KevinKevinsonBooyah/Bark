diff --git a/static/bark.css b/static/bark.css
new file mode 100644
index 0000000..f8cadd7
--- /dev/null
+++ b/static/bark.css
@@ -0,0 +1,113 @@
+html,body {overscroll-behavior:none;}
+body.bark-editor {overflow:hidden; user-select:none; -webkit-user-select:none;}
+input,textarea,[contenteditable=true] {user-select:text; -webkit-user-select:text;}
+#bark-tools {height:38px;box-sizing:border-box;display:flex;align-items:center;gap:4px;padding:3px 8px;background:#34241b;color:#eee;border-bottom:1px solid #271911;font:12px Arial,sans-serif;white-space:nowrap;position:relative;z-index:8;}
+#bark-tools button,#bark-tools select,.bark-dialog button {border:1px solid #896447;border-radius:4px;color:#f4f5f7;background:#59402e;min-height:30px;padding:4px 9px;font:inherit;cursor:pointer;}
+#bark-tools button:hover,.bark-dialog button:hover {background:#765337;border-color:#e5b87d;}
+#bark-tools button:focus-visible,.bark-dialog button:focus-visible {outline:2px solid #e5b87d;outline-offset:1px;}
+#bark-tools button:disabled {opacity:.5;cursor:wait;}
+#bark-tools .bark-run {color:#80e6a3;}
+#bark-tools .bark-stop {color:#ff9b9b;}
+.bark-divider {height:20px;border-left:1px solid #4b515b;margin:0 4px;}
+.bark-search {display:flex;min-width:100px;max-width:205px;margin-left:5px;}
+.bark-search input {width:100%;min-width:40px;border:1px solid #896447;border-radius:4px 0 0 4px;background:#261b16;color:white;padding:5px 8px;font:inherit;}
+.bark-status {margin-left:auto;font-size:11px;color:#b2bcc8;overflow:hidden;text-overflow:ellipsis;}
+#bark-tools .bark-recover {background:#805530;color:white;}
+.bark-modal-overlay {position:fixed;inset:0;background:#0009;z-index:100000;display:flex;justify-content:center;align-items:center;padding:10px;}
+.bark-dialog {background:#33251e;color:#edf0f5;font:14px/1.5 Arial,sans-serif;max-width:640px;width:100%;max-height:calc(100dvh - 20px);border-radius:6px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 12px 50px #0006;}
+.bark-dialog header {display:flex;align-items:center;justify-content:space-between;background:#795033;padding:10px 16px;flex:none;}
+.bark-dialog h2 {font-size:18px;margin:0;}
+.bark-dialog-body {overflow:auto;padding:16px 22px;}
+.bark-dialog p {margin:0 0 14px;}
+.bark-dialog a {color:#f2c58e;}
+.bark-dialog label {display:block;margin-bottom:14px;}
+.bark-saved-project {display:flex;align-items:center;gap:8px;padding:12px 0;border-top:1px solid #454c57;}
+.bark-saved-project>div {flex:1;min-width:0;overflow-wrap:anywhere;}
+.bark-saved-project small {display:block;color:#a7b3c4;}
+#bark-rotate {display:none;}
+.bark-hide-stage [class*="gui_stage-and-target-wrapper"] {display:none!important;}
+.bark-hide-sprites [class*="gui_target-wrapper"] {display:none!important;}
+.bark-reduced-motion *, .bark-reduced-motion *:before,.bark-reduced-motion *:after {animation:none!important;transition:none!important;scroll-behavior:auto!important;}
+[class*="menu-bar_scratch-logo"] {width:100px!important;}
+[class*="modal_modal-content"], [class*="custom-procedures_modal-content"] {max-width:calc(100vw - 24px);max-height:calc(100dvh - 24px);}
+[class*="custom-procedures_modal-content"] {margin:12px auto!important;overflow-y:auto!important;}
+[class*="custom-procedures_workspace"] {min-height:120px!important;}
+[class*="custom-procedures_body"] {padding:14px 22px!important;}
+[class*="custom-procedures_option-card"] {padding:10px!important;}
+[class*="custom-procedures_color-picker-area"] {margin:10px 0!important;}
+[class*="custom-procedures_preset-color"], [class*="custom-procedures_parent-custom"] {width:26px!important;height:26px!important;}
+@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;}}
+#bark-tools {overflow-x:auto;scrollbar-width:thin;}
+#bark-tools>* {flex-shrink:0;}
+#bark-tools .bark-search {flex-shrink:1;}
