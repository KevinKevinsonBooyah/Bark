diff --git a/src/bark/toolbar.jsx b/src/bark/toolbar.jsx
new file mode 100644
index 0000000..793531d
--- /dev/null
+++ b/src/bark/toolbar.jsx
@@ -0,0 +1,115 @@
+import React from 'react';
+import {connect} from 'react-redux';
+import localforage from 'localforage';
+import {setProjectTitle} from '../reducers/project-title';
+import downloadBlob from '../lib/download-blob';
+const store = localforage.createInstance({name:'bark-projects'});
+const workspace = () => window.ScratchBlocks && window.ScratchBlocks.getMainWorkspace();
+class BarkToolbar extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {status:'Recovery ready', recovery:null, projects:null, busy:false, query:'', reduced:false};
+        this.ready = false; this.dirty = false; this.checking = true;
+        this.change = () => {if(this.ready) this.dirty = true;};
+        this.loaded = () => {this.ready = true; this.dirty = true;};
+        this.key = e => {if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's'){e.preventDefault();this.save(true);}};
+    }
+    componentDidMount () {
+        const vm = this.props.vm;
+        vm.on('PROJECT_CHANGED',this.change); vm.runtime.on('PROJECT_LOADED',this.loaded);
+        this.ready = vm.runtime.targets.length > 0;
+        document.addEventListener('keydown',this.key);
+        document.body.classList.add('bark-editor');
+        if (matchMedia('(max-width:1000px) and (orientation:landscape)').matches) document.body.classList.add('bark-hide-stage');
+        try {const reduced = localStorage.getItem('bark:reduced-motion') === 'true';this.setState({reduced});document.body.classList.toggle('bark-reduced-motion',reduced);} catch(e) { /* optional preference */ }
+        store.getItem('recovery').then(recovery => {if(!this.disposed)this.setState({recovery,status:recovery?'Previous session available':'Recovery ready'});}).catch(() => this.setState({status:'Storage unavailable — use Export'})).finally(() => {this.checking=false;});
+        this.interval = setInterval(() => {if(this.ready && this.dirty && !this.state.recovery && !this.checking && !this.state.busy)this.save(false);},12000);
+    }
+    componentDidUpdate (prev) {if(prev.title !== this.props.title)this.dirty=true;}
+    componentWillUnmount () {
+        this.disposed=true;clearInterval(this.interval);
+        this.props.vm.removeListener('PROJECT_CHANGED',this.change);this.props.vm.runtime.removeListener('PROJECT_LOADED',this.loaded);
+        document.removeEventListener('keydown',this.key);document.body.classList.remove('bark-editor');
+    }
+    async save (manual) {
+        if(!this.ready || this.state.busy)return;
+        this.setState({busy:true,status:'Saving…'});this.dirty=false;
+        try {
+            const blob=await this.props.vm.saveProjectSb3();
+            const record={title:this.props.title || 'Bark project',time:Date.now(),data:await blob.arrayBuffer()};
+            if(manual)await store.setItem(`project:${record.title}`,record);
+            await store.setItem('recovery',record);
+            this.setState({status:manual?'Saved on this device':'Recovery saved',recovery:null});
+        } catch(e){this.dirty=true;this.setState({status:'Save failed — use Export',error:String(e.message || e)});}
+        finally {this.setState({busy:false});}
+    }
+    async exportProject () {
+        try {downloadBlob(`${this.props.title || 'Bark project'}.pmp`,await this.props.vm.saveProjectSb3());}
+        catch(e){this.setState({error:`Export failed: ${e.message || e}`});}
+    }
+    async loadRecord (record) {
+        if(!confirm(`Open “${record.title}”? Save or export your current work first if you want to keep it.`))return;
+        this.setState({busy:true});
+        try {this.props.vm.stopAll();await this.props.vm.loadProject(record.data);this.props.setTitle(record.title);this.setState({recovery:null,projects:null,status:'Project restored'});this.dirty=true;}
+        catch(e){this.setState({error:`Could not open project: ${e.message || e}`});}
+        finally {this.setState({busy:false});}
+    }
+    async openProjects () {
+        try {const projects=[];await store.iterate((v,k)=>{if(k.startsWith('project:'))projects.push({...v,key:k});});this.setState({projects:projects.sort((a,b)=>b.time-a.time)});}
+        catch(e){this.setState({error:'Device storage is unavailable. Import and export still work.'});}
+    }
+    async sample (name) {
+        if(!name || !confirm('Open this example? Save or export your current work first if you want to keep it.'))return;
+        this.setState({busy:true});
+        try {const response=await fetch(`${process.env.ROOT}samples/${name}.sb3`);if(!response.ok)throw new Error(`HTTP ${response.status}`);this.props.vm.stopAll();await this.props.vm.loadProject(await response.arrayBuffer());this.props.setTitle({bounce:'Bouncing Bark',broadcast:'Broadcast Party',touch:'Follow Your Finger'}[name]);this.setState({recovery:null,status:'Example opened — press Run'});}
+        catch(e){this.setState({error:`Example failed: ${e.message || e}`});}
+        finally {this.setState({busy:false});}
+    }
+    search () {
+        const ws=workspace(),query=this.state.query.toLowerCase().trim();if(!ws || !query)return;
+        const matches=ws.getAllBlocks(false).filter(b=>!b.isShadow() && b.toString().toLowerCase().includes(query));
+        if(!matches.length){this.setState({status:'No matches in this sprite'});return;}
+        this.matchIndex=this.lastQuery===query?((this.matchIndex+1)%matches.length):0;this.lastQuery=query;
+        const b=matches[this.matchIndex];b.select();if(ws.centerOnBlock)ws.centerOnBlock(b.id);
+        this.setState({status:`Match ${this.matchIndex+1} of ${matches.length}`});
+    }
+    panel (name) {document.body.classList.toggle(`bark-hide-${name}`);window.dispatchEvent(new Event('resize'));}
+    close () {this.setState({projects:null,help:false,error:null});}
+    render () {
+        const s=this.state;
+        return <React.Fragment>
+            <nav id="bark-tools" aria-label="Bark project tools">
+                <button className="bark-run" title="Run project" onClick={()=>this.props.vm.greenFlag()}>⚑ <span>Run</span></button>
+                <button className="bark-stop" title="Stop project" onClick={()=>this.props.vm.stopAll()}>■ <span>Stop</span></button>
+                <span className="bark-divider"/>
+                <button disabled={s.busy} title="Save on this device (Ctrl+S)" onClick={()=>this.save(true)}>Save</button>
+                <button onClick={()=>this.openProjects()}>Open saved</button>
+                <button disabled={s.busy} onClick={()=>this.exportProject()}>Export</button>
+                <select aria-label="Open an example project" value="" disabled={s.busy} onChange={e=>this.sample(e.target.value)}><option value="">Examples</option><option value="bounce">Bouncing Bark</option><option value="broadcast">Broadcast Party</option><option value="touch">Follow Your Finger</option></select>
+                <button title="Undo" onClick={()=>{const ws=workspace();if(ws)ws.undo(false);}}>↶</button><button title="Redo" onClick={()=>{const ws=workspace();if(ws)ws.undo(true);}}>↷</button>
+                <form className="bark-search" onSubmit={e=>{e.preventDefault();this.search();}}><input aria-label="Find blocks in this sprite’s scripts" placeholder="Find in scripts…" value={s.query} onChange={e=>this.setState({query:e.target.value})}/><button type="submit" title="Find next block">⌕</button></form>
+                <button onClick={()=>this.panel('stage')}>Stage</button><button onClick={()=>this.panel('sprites')}>Sprites</button>
+                <button onClick={()=>this.setState({help:true})}>Help</button><span className="bark-status" role="status">{s.status}</span>
+                {s.recovery && <button className="bark-recover" onClick={()=>this.loadRecord(s.recovery)}>Recover session</button>}
+            </nav>
+            <div id="bark-rotate"><div className="bark-phone">▯</div><h1>ROTATE YOUR DEVICE</h1><p>For the best Bark experience, rotate your phone sideways.</p></div>
+            {(s.projects!==null || s.help || s.error) && <div className="bark-modal-overlay" onClick={()=>this.close()}><section className="bark-dialog" role="dialog" aria-modal="true" aria-label={s.error?'Bark error':s.help?'Bark help':'Saved projects'} onClick={e=>e.stopPropagation()}>
+                <header><h2>{s.error?'Something went wrong':s.help?'Bark · Help & settings':'Saved on this device'}</h2><button autoFocus aria-label="Close dialog" onClick={()=>this.close()}>×</button></header>
+                <div className="bark-dialog-body">
+                {s.error && <p>{s.error}</p>}
+                {s.projects!==null && <React.Fragment><p>Device saves stay in this browser. Export a .pmp file to keep a portable backup.</p>{!s.projects.length && <p>No saved projects yet. Click Save to create one.</p>}{s.projects.map(p=><div className="bark-saved-project" key={p.key}><div><strong>{p.title}</strong><small>{new Date(p.time).toLocaleString()}</small></div><button disabled={s.busy} onClick={()=>this.loadRecord(p)}>Open</button><button onClick={async()=>{if(confirm(`Delete “${p.title}” from this device?`)){await store.removeItem(p.key);this.openProjects();}}}>Delete</button></div>)}</React.Fragment>}
+                {s.help && <React.Fragment>
+                    <p>Drag blocks from a category into the workspace. Snap a stack below a green-flag event and press Run. Rounded reporters fit inside inputs; hexagonal conditions fit Boolean slots.</p>
+                    <p><strong>My Blocks → Make a Block</strong> creates functions with number/text, Boolean and branch parameters, return values, custom colors and warp execution. Right-click a call to edit its definition.</p>
+                    <p><strong>On phones:</strong> rotate sideways. Stage and Sprites make room for coding. Long-press a block for its menu. Open the stage fullscreen to play. Sensing includes individual finger positions.</p>
+                    <p><strong>Files:</strong> File → Load from your computer imports .sb3 and .pmp. Export saves .pmp with scripts, costumes, sounds and functions. PenguinMod-specific blocks do not run in standard Scratch.</p>
+                    <p><strong>Shortcuts:</strong> Ctrl/Cmd+S saves on this device; Ctrl/Cmd+Z undoes. Search finds blocks in the selected sprite’s scripts. Recovery saves edited projects every 12 seconds. Recover session reopens the last session; saving a new project replaces recovery.</p>
+                    <label><input type="checkbox" checked={s.reduced} onChange={e=>{const reduced=e.target.checked;this.setState({reduced});document.body.classList.toggle('bark-reduced-motion',reduced);try{localStorage.setItem('bark:reduced-motion',String(reduced));}catch(err){}}}/> Reduce animations</label>
+                    <p>Microphone and clipboard blocks depend on browser permissions. Bark has no account, community upload or cloud-variable server. Optional extensions and asset libraries may contact their providers.</p>
+                    <p>Powered by PenguinMod, TurboWarp and Scratch. <a href="credits.html" target="_blank" rel="noopener noreferrer">Credits</a> · <a href="https://github.com/KevinKevinsonBooyah/Bark" target="_blank" rel="noopener noreferrer">Source, licenses & limitations</a></p>
+                </React.Fragment>}
+                </div></section></div>}
+        </React.Fragment>;
+    }
+}
+export default connect(s=>({title:s.scratchGui.projectTitle}),d=>({setTitle:title=>d(setProjectTitle(title))}))(BarkToolbar);
